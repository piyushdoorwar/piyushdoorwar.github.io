{
  "name": "piyushdoorwar.github.io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal portfolio of Piyush Doorwar",
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:traffic",
    "test:watch": "vitest",
    "test:traffic": "node --test scripts/fetch-traffic.test.mjs",
    "fetch-stats": "node scripts/fetch-stats.mjs",
    "fetch-traffic": "node scripts/fetch-traffic.mjs",
    "fetch-medium": "node scripts/fetch-medium.mjs",
    "enrich-medium": "node scripts/enrich-medium.mjs",
    "fetch-data": "node scripts/fetch-stats.mjs && node scripts/fetch-traffic.mjs && node scripts/fetch-medium.mjs"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "d3-geo": "^3.1.1",
    "framer-motion": "^11.3.19",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.2.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "iso-3166-1": "^2.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
